{
  "name": "skillswap",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter skillswap-backend --filter skillswap-frontend dev",
    "dev:backend": "pnpm --filter skillswap-backend dev",
    "dev:frontend": "pnpm --filter skillswap-frontend dev",
    "build": "pnpm --filter skillswap-backend build && pnpm --filter skillswap-frontend build",
    "db:start": "\"C:\\Program Files\\PostgreSQL\\18\\bin\\pg_ctl.exe\" -D backend/postgres_data -o \"-p 5432\" -l backend/postgres.log start",
    "db:stop": "\"C:\\Program Files\\PostgreSQL\\18\\bin\\pg_ctl.exe\" -D backend/postgres_data stop"
  }
}
