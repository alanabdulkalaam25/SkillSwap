generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum ProficiencyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
}

enum ExchangeStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELED
}

model User {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  password   String
  department String
  semester   Int
  rollNumber String   @unique
  bio        String?  @default("")
  role       Role     @default(STUDENT)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  offeredSkills     OfferedSkill[]
  wantedSkills      WantedSkill[]
  sentExchanges     ExchangeRequest[] @relation("ExchangeSender")
  receivedExchanges ExchangeRequest[] @relation("ExchangeReceiver")
}

model Skill {
  id          String   @id @default(uuid())
  name        String   @unique
  category    String
  description String?
  createdAt   DateTime @default(now())

  offeredBy OfferedSkill[]
  wantedBy  WantedSkill[]
}

model OfferedSkill {
  id          String           @id @default(uuid())
  userId      String
  skillId     String
  proficiency ProficiencyLevel @default(INTERMEDIATE)
  description String?
  createdAt   DateTime         @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill            Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)
  exchangeRequests ExchangeRequest[]

  @@unique([userId, skillId])
}

model ExchangeRequest {
  id             String         @id @default(uuid())
  senderId       String
  receiverId     String
  offeredSkillId String
  wantedSkillId  String
  message        String         @default("")
  status         ExchangeStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  sender       User         @relation("ExchangeSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver     User         @relation("ExchangeReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  offeredSkill OfferedSkill @relation(fields: [offeredSkillId], references: [id], onDelete: Cascade)
  wantedSkill  WantedSkill  @relation(fields: [wantedSkillId], references: [id], onDelete: Cascade)

  @@index([senderId, status, createdAt])
  @@index([receiverId, status, createdAt])
}

model WantedSkill {
  id        String        @id @default(uuid())
  userId    String
  skillId   String
  priority  PriorityLevel @default(MEDIUM)
  notes     String?
  createdAt DateTime      @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill            Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)
  exchangeRequests ExchangeRequest[]

  @@unique([userId, skillId])
}
